# values can be either "polygon"/"alpaca"/"gemini"/"finnhub"
DATA_CONNECTOR="alpaca"

# market calendar of US equities for back-testing: "alpaca"
CALENDAR_CONNECTOR="alpaca"

# which broker to use? alpaca/gemini
LIU_BROKER="alpaca"

# Polygon API key
POLYGON_API_KEY=""

# Alpaca Credentials, note base URL needs to be changed
# when switching to LIVE account
APCA_API_BASE_URL="https://paper-api.alpaca.markets"
ALPACA_STREAM_URL="wss://stream.data.alpaca.markets/v2/sip"
APCA_API_KEY_ID=""
APCA_API_SECRET_KEY=""

# ALPACA market data subscription flag, note use "iex" for free and "sip" for PRO
ALPACA_DATA_FEED="iex" 

# Gemini 
GEMINI_API_KEY=
GEMINI_API_SECRET=

# lock number of CPUs & consumer processes to use
CPU_FACTOR=4
NUM_CONSUMERS=4

# Look for TOML files in this folder. Each file describes a strategy
TRADEPLAN_DIR=.

# Database URL, e.g. postgresql://user:password@localhost/liu; leave unset
# for the SQLite database at ~/.liualgotrader/liu.db
# DSN=""

# Enable tracing, using OpenTelemetry, enabled = 1, disabled = 0 (DEFAULT)
LIU_TRACE_ENABLED=0

# Enable debugging,  enabled = 1, disabled = 0 (DEFAULT)
LIU_DEBUG_ENABLED=1

# Minimum log level: DEBUG/INFO (DEFAULT)/WARNING/ERROR
LIU_LOG_LEVEL=INFO

# When a rule requests a symbol that another rule owns, stop trading or
# back-testing with an error = 1, or deactivate the rule with a warning = 0
# (DEFAULT)
LIU_HALT_ON_COLLISION=0
